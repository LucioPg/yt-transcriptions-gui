{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "YouTube Transcriptor",
  "version": "0.1.0",
  "identifier": "com.yt-transcriptor.app",
  "build": {
    "frontendDist": "../web-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "YouTube Transcriptor",
        "width": 1000,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.svg"
    ],
    "resources": [
      "../src/**/*.py",
      "../pyproject.toml",
      "../requirements.txt"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {}
}