{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "YouTube Transcriptor",
  "version": "0.1.0",
  "identifier": "com.yt-transcriptor.ui",
  "build": {
    "frontendDist": "../web-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "YouTube Transcriptor",
        "width": 1000,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "../web-dist/index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:8031"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.svg"
    ],
    "resources": [
      "resources/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {}
}
